# App mode: development | test | production
NODE_ENV=development

# HTTP port (env is a string; the schema coerces it to a number)
PORT=3000

# Hostname of PgBouncer (compose publishes it on localhost)
DB_HOST=localhost

# PgBouncer port on the host (compose maps 6432:6432). Direct Postgres remains 5433.
DB_PORT=6432

# Database name
DB_NAME=minibnb

# Database user (this is not the password)
DB_USER=minibnb

# Path to the password FILE. The password itself must not live in env
DB_PASSWORD_FILE=./secrets/db_password

# App connection URI. Fake password here. Real value comes from Infisical (dev/prod), not a tracked .env
DATABASE_URL=postgres://minibnb:fake-password@localhost:6432/minibnb

# Pact Broker (local compose --profile pact). Token stays in env / CI secrets, never in git.
PACT_BROKER_URL=http://localhost:9292
