# App mode: development | test | production
NODE_ENV=development

# HTTP port (env is a string; the schema coerces it to a number)
PORT=3000

# Postgres hostname (compose service is reachable as localhost from the host)
DB_HOST=localhost

# Postgres port on the host. Default 5432; use 5433 if a local Postgres already owns 5432
DB_PORT=5432

# Database name
DB_NAME=minibnb

# Database user (this is not the password)
DB_USER=minibnb

# Path to the password FILE. The password itself must not live in env
DB_PASSWORD_FILE=./secrets/db_password

# App connection URI. Fake password here. Real value comes from Infisical (dev/prod), not a tracked .env
DATABASE_URL=postgres://minibnb:fake-password@localhost:5432/minibnb
